{
  "name": "client",
  "private": false,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "format": "prettier . --write --cache --ignore-unknown",
    "format:check": "prettier . --check --cache --ignore-unknown",
    "lint": "eslint .",
    "preview": "vite preview",
    "lint:fsd": "steiger src --fail-on-warnings"
